{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      }
    },

    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_UPDATE_SERVER_BASE": "https://ota-test--update-server.netlify.app"
      }
    },

    "production": {
      "env": {
        "APP_VARIANT": "production"
      }
    }
  }
}