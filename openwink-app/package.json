{
  "name": "openwink-app",
  "version": "2.2.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client --private-key-path ./keys/private-key.pem",
    "android": "expo start --dev-client --android --private-key-path ./keys/private-key.pem",
    "ios": "expo start --dev-client --ios --private-key-path ./keys/private-key.pem",
    "run:android": "expo run:android",
    "run:ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:all": "eas build --profile development --platform all",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:preview:all": "eas build --profile preview --platform all",
    "build:prod:android": "eas build --profile production --platform android",
    "build:prod:ios": "eas build --profile production --platform ios",
    "build:prod:all": "eas build --profile production --platform all",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "update:dev": "eas update --branch development",
    "update:preview": "eas update --branch preview",
    "update:prod": "eas update --branch production",
    "ota:publish": "node scripts/publish-app-ota.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans": "^0.4.0",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@gorhom/portal": "^1.0.14",
    "@howincodes/expo-dynamic-app-icon": "^3.0.2",
    "@ptomasroos/react-native-multi-slider": "^2.2.2",
    "@react-native-vector-icons/material-design-icons": "^12.3.0",
    "@react-native-vector-icons/octicons": "^20.3.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.1.14",
    "expo": "^54.0.38",
    "expo-application": "~7.0.8",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-base64": "^0.2.1",
    "react-native-ble-plx": "^3.5.1",
    "react-native-bouncy-checkbox": "^4.1.2",
    "react-native-device-info": "^14.1.1",
    "react-native-draglist": "^3.9.9",
    "react-native-dropdown-picker": "^5.4.6",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-mmkv": "^3.3.3",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-sticky-range-slider": "^0.1.7",
    "react-native-svg": "15.12.1",
    "react-native-toast-message": "^2.3.3",
    "react-native-walkthrough-tooltip": "^1.6.0",
    "react-native-worklets": "0.5.1",
    "rn-vertical-slider-matyno": "^1.0.1",
    "toggle-switch-react-native": "^3.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "@types/react-native-base64": "^0.2.2",
    "dotenv": "^17.2.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
